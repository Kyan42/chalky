# Copy to .env.local and fill in. Read only on the server, except NEXT_PUBLIC_* (not secrets).
# The full table is in README.md, under Setup.

# Required
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=

# Convex records, the live /log page and memory across lessons (docs/convex.md).
# The first two are written by: npx convex dev --once --configure new --project chalky --dev-deployment cloud
# NEXT_PUBLIC_CONVEX_URL=
# CONVEX_DEPLOYMENT=
# Same value as on the deployment: npx convex env set CHALKY_WRITE_SECRET <value>
# CHALKY_WRITE_SECRET=

# Time-sensitive questions (without it, Chalky teaches from what it knows)
# APIFY_TOKEN=

# Run the lesson on OpenAI models instead (docs/openai.md)
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=

# Search with Moss instead of the local engine (docs/retrieval.md)
# RETRIEVAL_ENGINE=moss
# MOSS_PROJECT_ID=
# MOSS_PROJECT_KEY=

# Optional
# CHALKY_LIVE_LOG=1
# NEXT_PUBLIC_CHALKY_VOICE_BARGE_IN=1
# NEXT_PUBLIC_CHALKY_THEME=chalk
# SONIC_SPEED=0.92
# CARTESIA_VOICE_ID=
# CARTESIA_MODEL_ID=
