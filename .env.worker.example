# Keys the animation builder (npm run worker) uses on your laptop. Copy to .env.worker and fill in.
# The Convex URL is read from .env.local, which `npx convex dev` writes.

# Same value as WORKER_SECRET in .env.convex.
WORKER_SECRET=YOUR_WORKER_SECRET

# Cartesia API key, for recording narration with word timestamps.
CARTESIA_API_KEY=YOUR_CARTESIA_API_KEY

# Optional. Keep the voice the same as the Convex one so the tutor sounds like one person.
# CARTESIA_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238

# Optional: the model Claude Code uses to author animations, and how many jobs run at once.
# BUILDER_MODEL=claude-opus-5-5
# WORKER_CONCURRENCY=2

# Claude Code signs in with your normal `claude` login. To use an API key instead, set:
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
