# Keys the Convex backend uses. Copy to .env.convex, fill in, then: npm run keys
# (They live on the Convex deployment, not in the browser.)

# Claude API key for the live tutor (conversation, syllabus, grading, detours). https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Cartesia API key. The backend mints short-lived browser tokens from it. https://play.cartesia.ai/keys
CARTESIA_API_KEY=YOUR_CARTESIA_API_KEY

# Any long random string. Must match WORKER_SECRET in .env.worker.
WORKER_SECRET=YOUR_WORKER_SECRET

# Optional: the tutor's voice (Cartesia voice id) and the tutor's model.
# CARTESIA_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238
# TUTOR_MODEL=claude-opus-5-5
